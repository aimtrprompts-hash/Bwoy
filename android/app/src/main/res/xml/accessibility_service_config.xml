<?xml version="1.0" encoding="utf-8"?>
<!-- Only window changes are watched (which app is in front). No screen content is read: canRetrieveWindowContent is off.
     All apps are listed (no packageNames filter) so the Home-button test can show what the Fire TV really reports;
     only a home app other than Hearth makes Hearth open (see HomeWatchService). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description"
    android:notificationTimeout="50" />
